{
    "compilerOptions": {
        "target": "es2022",
        "module": "es2022",
        "lib": ["es2022"],
        "declaration": true,
        "sourceMap": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": false,
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "jsx": "react-jsx"
    },
    "exclude": ["dist", "node_modules", "tests", "vitest.config.ts"]
}
