{
    "developers": ["<YOUR_DISCORD_ID>"],
    "client": {
        "id": "<DISCORD_BOT_ID>",
        "token": "<DISCORD_BOT_TOKEN>",
        "intents": [
            "Guilds",
            "GuildMessages",
            "GuildMessageReactions",
            "MessageContent",
            "DirectMessages",
            "DirectMessageReactions"
        ],
        "partials": ["Message", "Channel", "Reaction"],
        "caches": {
            "AutoModerationRuleManager": 0,
            "BaseGuildEmojiManager": 0,
            "GuildEmojiManager": 0,
            "GuildBanManager": 0,
            "GuildInviteManager": 0,
            "GuildScheduledEventManager": 0,
            "GuildStickerManager": 0,
            "MessageManager": 0,
            "PresenceManager": 0,
            "StageInstanceManager": 0,
            "ThreadManager": 0,
            "ThreadMemberManager": 0,
            "VoiceStateManager": 0
        }
    },
    "api": {
        "port": 3001,
        "secret": "00000000-0000-0000-0000-000000000000"
    },
    "sharding": {
        "spawnDelay": 5,
        "spawnTimeout": 300,
        "serversPerShard": 1000
    },
    "clustering": {
        "enabled": false,
        "shardCount": 16,
        "callbackUrl": "http://localhost:3001/",
        "masterApi": {
            "url": "http://localhost:5000/",
            "token": "00000000-0000-0000-0000-000000000000"
        }
    },
    "jobs": {
        "updateServerCount": {
            "schedule": "0 */10 * * * *",
            "log": false,
            "runOnce": false,
            "initialDelaySecs": 0
        },
        "processScheduledMessages": {
            "schedule": "0 * * * * *",
            "log": false,
            "runOnce": false,
            "initialDelaySecs": 10
        },
        "enqueueProactiveMessages": {
            "schedule": "0 0 * * * *",
            "log": false,
            "initialDelaySecs": 20
        }
    },
    "rateLimiting": {
        "commands": {
            "amount": 10,
            "interval": 30
        },
        "buttons": {
            "amount": 10,
            "interval": 30
        },
        "triggers": {
            "amount": 10,
            "interval": 30
        },
        "reactions": {
            "amount": 10,
            "interval": 30
        }
    },
    "messageReactions": {
        "enabled": true,
        "cooldownSeconds": 30
    },
    "conversationFollowUps": {
        "enabled": true,
        "windowSeconds": 120
    },
    "logging": {
        "pretty": true,
        "rateLimit": {
            "minTimeout": 30
        }
    },
    "openai": {
        "apiKey": "<OPENAI_API_KEY>"
    },
    "kagi": {
        "enabled": false,
        "apiKey": "",
        "maxResults": 5,
        "maxExtractChars": 12000,
        "cacheEntries": 256,
        "cacheTtlSeconds": 120,
        "maxToolRounds": 3,
        "maxUpstreamCallsPerMessage": 3,
        "maxCallsPerUserPerHour": 10,
        "requestTimeoutMs": 10000
    },
    "moderation": {
        "webAssisted": {
            "enabled": true,
            "model": "omni-moderation-latest",
            "timeoutMs": 5000
        }
    },
    "automations": {
        "enabled": true
    },
    "conversationContext": {
        "expiryHours": 24,
        "maxMessages": 40
    },
    "aiRouting": {
        "enabled": false,
        "rolloutPercent": 0,
        "dataProvenance": {
            "modelAvailability": "GET /v1/models using this project's API key",
            "modelAvailabilityCheckedAt": "2026-07-15",
            "pricing": "https://developers.openai.com/api/docs/pricing (standard tier)",
            "pricingCheckedAt": "2026-07-15",
            "usageBasedPolicy": false
        },
        "telemetry": {
            "enabled": true
        },
        "tasks": {
            "intent_detection": { "model": "gpt-5.4-nano", "reasoningEffort": "low", "maxOutputTokens": 512, "timeoutMs": 3000, "maxCostUsd": 0.0006 },
            "reaction_selection": { "model": "gpt-5.6-luna", "fallbackModel": "gpt-5.6-terra", "reasoningEffort": "low", "maxOutputTokens": 128, "timeoutMs": 15000, "maxCostUsd": 0.001 },
            "memory_extraction": { "model": "gpt-5.6-luna", "reasoningEffort": "medium", "maxOutputTokens": 192, "timeoutMs": 8000, "maxCostUsd": 0.0012 },
            "summarization": { "model": "gpt-5.6-luna", "reasoningEffort": "high", "maxOutputTokens": 320, "timeoutMs": 15000, "maxCostUsd": 0.002 },
            "tool_selection": { "model": "gpt-5.6-luna", "reasoningEffort": "high", "maxOutputTokens": 256, "timeoutMs": 15000, "maxCostUsd": 0.0015 },
            "final_response": { "model": "gpt-5.6-luna", "fallbackModel": "gpt-5.6-terra", "reasoningEffort": "high", "maxOutputTokens": 700, "timeoutMs": 30000, "maxCostUsd": 0.005 },
            "image_analysis": { "model": "gpt-5.6-luna", "fallbackModel": "gpt-5.6-terra", "reasoningEffort": "high", "maxOutputTokens": 600, "timeoutMs": 30000, "maxCostUsd": 0.005 }
        },
        "prices": {
            "gpt-5.6-luna": { "inputPerMillion": 1, "outputPerMillion": 6 },
            "gpt-5.6-terra": { "inputPerMillion": 2.5, "outputPerMillion": 15 },
            "gpt-5.6-sol": { "inputPerMillion": 5, "outputPerMillion": 30 }
        }
    },
    "memory": {
        "enabled": true,
        "embeddingModel": "text-embedding-3-small",
        "similarityThreshold": 0.35,
        "recallLimit": 8,
        "maxContentLength": 1000,
        "dedupeThreshold": 0.9
    },
    "imageUpload": {
        "baseUrl": "<IMAGE_UPLOAD_BASE_URL>",
        "username": "<IMAGE_UPLOAD_USERNAME>",
        "password": "<IMAGE_UPLOAD_PASSWORD>"
    },
    "db": {
        "host": "<DB_HOST>",
        "port": 5432,
        "user": "<DB_USER>",
        "password": "<DB_PASSWORD>",
        "database": "<DB_NAME>",
        "connectionString": "<DB_CONNECTION_STRING>"
    },
    "fal": {
        "apiKey": "<FAL_API_KEY>"
    }
}
