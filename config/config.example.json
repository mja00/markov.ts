{
    "developers": ["<YOUR_DISCORD_ID>"],
    "client": {
        "id": "<DISCORD_BOT_ID>",
        "token": "<DISCORD_BOT_TOKEN>",
        "intents": [
            "Guilds",
            "GuildMessages",
            "GuildMessageReactions",
            "DirectMessages",
            "DirectMessageReactions"
        ],
        "partials": ["Message", "Channel", "Reaction"],
        "caches": {
            "AutoModerationRuleManager": 0,
            "BaseGuildEmojiManager": 0,
            "GuildEmojiManager": 0,
            "GuildBanManager": 0,
            "GuildInviteManager": 0,
            "GuildScheduledEventManager": 0,
            "GuildStickerManager": 0,
            "MessageManager": 0,
            "PresenceManager": 0,
            "StageInstanceManager": 0,
            "ThreadManager": 0,
            "ThreadMemberManager": 0,
            "VoiceStateManager": 0
        }
    },
    "api": {
        "port": 3001,
        "secret": "00000000-0000-0000-0000-000000000000"
    },
    "sharding": {
        "spawnDelay": 5,
        "spawnTimeout": 300,
        "serversPerShard": 1000
    },
    "clustering": {
        "enabled": false,
        "shardCount": 16,
        "callbackUrl": "http://localhost:3001/",
        "masterApi": {
            "url": "http://localhost:5000/",
            "token": "00000000-0000-0000-0000-000000000000"
        }
    },
    "jobs": {
        "updateServerCount": {
            "schedule": "0 */10 * * * *",
            "log": false,
            "runOnce": false,
            "initialDelaySecs": 0
        },
        "processScheduledMessages": {
            "schedule": "0 * * * * *",
            "log": false,
            "runOnce": false,
            "initialDelaySecs": 10
        },
        "enqueueProactiveMessages": {
            "schedule": "0 0 * * * *",
            "log": false,
            "initialDelaySecs": 20
        }
    },
    "rateLimiting": {
        "commands": {
            "amount": 10,
            "interval": 30
        },
        "buttons": {
            "amount": 10,
            "interval": 30
        },
        "triggers": {
            "amount": 10,
            "interval": 30
        },
        "reactions": {
            "amount": 10,
            "interval": 30
        }
    },
    "logging": {
        "pretty": true,
        "rateLimit": {
            "minTimeout": 30
        }
    },
    "openai": {
        "apiKey": "<OPENAI_API_KEY>"
    },
    "automations": {
        "enabled": true
    },
    "conversationContext": {
        "expiryHours": 24,
        "maxMessages": 40
    },
    "aiRouting": {
        "enabled": false,
        "rolloutPercent": 0,
        "telemetry": {
            "enabled": true
        },
        "tasks": {
            "intent_detection": { "model": "gpt-5.4-nano", "maxOutputTokens": 128, "timeoutMs": 5000, "maxCostUsd": 0.002 },
            "memory_extraction": { "model": "gpt-5.4-nano", "maxOutputTokens": 256, "timeoutMs": 8000, "maxCostUsd": 0.004 },
            "summarization": { "model": "gpt-5.4-mini", "maxOutputTokens": 512, "timeoutMs": 15000, "maxCostUsd": 0.01 },
            "tool_selection": { "model": "gpt-5.4-mini", "fallbackModel": "gpt-5.4", "maxOutputTokens": 512, "timeoutMs": 15000, "maxCostUsd": 0.02 },
            "final_response": { "model": "gpt-5.4-mini", "fallbackModel": "gpt-5.4", "maxOutputTokens": 1000, "timeoutMs": 30000, "maxCostUsd": 0.05 },
            "image_analysis": { "model": "gpt-5.4", "fallbackModel": "gpt-5.4-mini", "maxOutputTokens": 1000, "timeoutMs": 30000, "maxCostUsd": 0.08 }
        },
        "prices": {
            "gpt-5.4-nano": { "inputPerMillion": 0, "outputPerMillion": 0 },
            "gpt-5.4-mini": { "inputPerMillion": 0, "outputPerMillion": 0 },
            "gpt-5.4": { "inputPerMillion": 0, "outputPerMillion": 0 }
        }
    },
    "memory": {
        "enabled": true,
        "embeddingModel": "text-embedding-3-small",
        "similarityThreshold": 0.35,
        "recallLimit": 8,
        "maxContentLength": 1000,
        "dedupeThreshold": 0.9
    },
    "imageUpload": {
        "baseUrl": "<IMAGE_UPLOAD_BASE_URL>",
        "username": "<IMAGE_UPLOAD_USERNAME>",
        "password": "<IMAGE_UPLOAD_PASSWORD>"
    },
    "db": {
        "host": "<DB_HOST>",
        "port": 5432,
        "user": "<DB_USER>",
        "password": "<DB_PASSWORD>",
        "database": "<DB_NAME>",
        "connectionString": "<DB_CONNECTION_STRING>"
    },
    "fal": {
        "apiKey": "<FAL_API_KEY>"
    }
}
